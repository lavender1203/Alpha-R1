# API keys — copy to .env and fill in. Never commit .env.

# OpenRouter (factor description generation, see configs/generation.yaml)
OPENROUTER_API_KEY=

# Hugging Face (optional; not required for the public FinStep/Alpha-R1)
HF_TOKEN=

# Training: verl data/model paths (see training/configs/grpo_alpha_r1.yaml)
# TRAIN_FILES=/path/to/train.parquet
# TEST_FILES=/path/to/val.parquet
# MODEL_PATH=/path/to/Qwen3-8B

# Training reward data context (see training/reward.py)
# ALPHA_R1_BETAS_CSV=/path/to/betas.csv
# ALPHA_R1_FACTOR_VALUES_DIR=/path/to/factor_values
# ALPHA_R1_PRICES_CSV=/path/to/prices.csv
# ALPHA_R1_BENCHMARK_CSV=/path/to/benchmark.csv
